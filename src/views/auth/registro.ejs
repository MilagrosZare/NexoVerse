<!--REGISTRO: crea una cuenta CLIENTE; el rol lo asigna el servidor, no el formulario. -->

<section class="auth-section">
    <div class="auth-side">
        <div class="eyebrow">UN LUGAR PARA CADA PLAYER</div>

        <!-- Título -->
        <h1>
            ENTRÁ<br>
            AL <span>JUEGO.</span>
        </h1>

        <p>
            Creá tu cuenta y reservá tu próxima sesión en unos pocos pasos.
        </p>

        <div class="auth-decoration">
            N<span>+</span>
        </div>
    </div>

    <div class="auth-panel">
        <div class="eyebrow">CREÁ TU PERFIL</div>

        <h2>Un paso más cerca.</h2>

        <p class="muted">
            ¿Ya tenés cuenta?
            <a href="/auth/ingresar">Iniciá sesión</a>
        </p>

        <% if (error) { %>
            <div class="form-error"><%= error %></div>
        <% } %>

        <!-- Formulario para crear al usuario -->

        <form method="post" action="/auth/registro" class="form-grid">
            <label>
                Nombre
                <input
                    name="nombre"
                    required
                    maxlength="80"
                    autocomplete="given-name"
                >
            </label>

            <label>
                Apellido
                <input
                    name="apellido"
                    required
                    maxlength="80"
                    autocomplete="family-name"
                >
            </label>

            <label class="span-2">
                Correo electrónico
                <input
                    name="email"
                    type="email"
                    required
                    maxlength="200"
                    autocomplete="email"
                >
            </label>

            <label class="span-2">
                Contraseña
                <input
                    name="password"
                    type="password"
                    required
                    minlength="8"
                    maxlength="128"
                    autocomplete="new-password"
                >
                <small>Usá al menos 8 caracteres.</small>
            </label>

            <button class="button span-2">
                Crear cuenta <span>↗</span>
            </button>
        </form>
    </div>
</section>