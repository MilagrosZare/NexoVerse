<!-- INGRESO: el formulario envía el identificador y la contraseña al controlador de autenticación. %> -->

<!-- Título -->
<section class="auth-section">
    <div class="auth-side">
        <div class="eyebrow">TU PRÓXIMA PARTIDA TE ESPERA</div>

        <h1>
            VOLVÉ<br>
            A <span>JUGAR.</span>
        </h1>

        <p>
            Ingresá a tu cuenta para reservar un equipo o revisar tus turnos.
        </p>

        <div class="auth-decoration">
            N<span>+</span>
        </div>
    </div>

    <div class="auth-panel">
        <div class="eyebrow">HOLA DE NUEVO</div>

        <h2>Iniciá sesión.</h2>

        <p class="muted">
            ¿Todavía no tenés cuenta?
            <a href="/auth/registro">Creala acá</a>
        </p>

        <% if (error) { %>
            <div class="form-error"><%= error %></div>
        <% } %>

        <!-- Formulario de inicio de sesión -->

        <form method="post" action="/auth/ingresar" class="form-grid">
            <label class="span-2">
                Correo
                <input
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                >
            </label>

            <label class="span-2">
                Contraseña
                <input
                    name="password"
                    type="password"
                    required
                    autocomplete="current-password"
                >
            </label>

            <button class="button span-2">
                Ingresar <span>↗</span>
            </button>
        </form>
    </div>
</section>