<%# El formulario crea una reserva en nombre de un cliente ya registrado. %>
<section class="page-banner"><div class="wrap"><div class="eyebrow">ADMINISTRACIÓN</div><h1>CREAR <span>RESERVA.</span></h1></div></section>
<section class="section wrap"><div class="contact-card">
  <%# El error explica qué dato hay que revisar antes de volver a enviar. %>
  <% if (error) { %><div class="form-error"><%= error %></div><% } %>
  <%# Los selectores obtienen sus opciones desde los clientes y recursos disponibles. %>
  <form method="post" action="/admin/reservas" class="form-grid">
    <label class="span-2">Cliente<select name="cliente" required><% clientes.forEach(cliente => { %><option value="<%= cliente.id %>"><%= cliente.nombre %> <%= cliente.apellido %> · <%= cliente.email %></option><% }) %></select></label>
    <label class="span-2">Equipo o sala<select name="recurso" required><% recursos.forEach(recurso => { %><option value="<%= recurso.id %>"><%= recurso.plataforma %> · <%= recurso.nombre %> · hasta <%= recurso.capacidad_maxima %></option><% }) %></select></label>
    <label>Modalidad<select name="modalidad"><option value="SOLO">Solo</option><option value="TEAM">Team</option></select></label>
    <label>Personas<input type="number" name="personas" min="1" max="10" value="1" required></label>
    <label>Fecha<input type="date" name="fecha" required></label>
    <label>Hora de inicio<select name="inicio" required><% for (let hora = 10; hora < 21; hora++) { const texto = `${String(hora).padStart(2, '0')}:00`; %><option value="<%= texto %>"><%= texto %></option><% } %></select></label>
    <label>Duración<select name="duracion"><option value="1">1 hora</option><option value="2">2 horas</option><option value="3">3 horas</option></select></label>
    <button class="button span-2">Confirmar reserva ↗</button>
  </form>
</div></section>
